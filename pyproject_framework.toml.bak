# @agent: session-260808-fleet-spruce | module: agent-teams-sdk-skeleton | ts: 2026-08-08T16:35+08:00
[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "agent-teams-sdk"
version = "0.1.0"
description = "通用 AgentTeams 协同框架：TeamRoom 黑板 + BaseAgent + BaseSkill + 角色模式（Memory Palace / SelfBrain 共用）"
readme = "README.md"
requires-python = ">=3.10"
license = { text = "Apache-2.0" }
authors = [{ name = "故障自愈小队" }]
dependencies = [
    "jsonschema>=4.0",
    "PyYAML>=6.0",
]

[project.optional-dependencies]
dev = ["pytest>=7.0"]

[tool.setuptools.packages.find]
include = ["agent_teams_sdk*"]

[tool.pytest.ini_options]
testpaths = ["tests"]
